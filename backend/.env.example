# Copia para .env e ajusta.

# Local: SQLite (ficheiro edupath.db nesta pasta).
# Produção (ex.: Neon): postgresql+psycopg://utilizador:password@host/base?sslmode=require
DATABASE_URL=sqlite:///./edupath.db

# Origens do frontend autorizadas (CORS), separadas por vírgulas.
CORS_ORIGINS=http://localhost:5173

# Fuso horário usado para saber se o prazo de um objetivo já terminou.
TIMEZONE=Europe/Lisbon

# Contas. Estes valores servem só para desenvolvimento; em produção usa valores
# próprios e aleatórios (vê o README).
# Chave para assinar as sessões: pelo menos 32 caracteres. Sem ela ninguém entra,
# e mudá-la termina todas as sessões abertas.
SESSION_SECRET=so-para-desenvolvimento-local-0123456789
# Código para criar a primeira conta (que fica administradora). Depois, as outras
# pessoas só entram com convites do administrador.
INVITE_CODE=convite-local
